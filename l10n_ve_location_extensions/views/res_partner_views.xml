<odoo>
    <data>
        <record id="view_partner_form_inherited_extensions" model="ir.ui.view">
            <field name="name">res.partner.product.form.inherit.extensions</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('o_address_format')]" position="replace">
                    <div class="o_address_format">
                        <field name="street" placeholder="Calle..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                        <field name="street2" placeholder="Calle 2..." class="o_address_street" readonly="type == 'contact' and parent_id"/>
                        
                        <field name="city" invisible="1"/>
                        <field name="city_id" invisible="1"/>
                        <field name="parish_id" invisible="1"/>
                        
                        <field name="state_id" class="o_address_state" placeholder="Estado" options="{'no_open': True, 'no_quick_create': True}" readonly="type == 'contact' and parent_id"/>
                        
                        <field name="municipality" class="o_address_street" placeholder="Municipio" required="1"/>
                        
                        <field name="zip" class="o_address_zip" placeholder="C.P" readonly="type == 'contact' and parent_id"/>
                        
                        <field name="country_id" placeholder="País" class="o_address_country" options='{"no_open": True, "no_create": True}' readonly="type == 'contact' and parent_id"/>
                    </div>
                </xpath>

                <xpath expr="//sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='city_id']" position="attributes">
                    <attribute name="required">0</attribute>
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form//field[@name='parish_id']" position="attributes">
                    <attribute name="required">0</attribute>
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>