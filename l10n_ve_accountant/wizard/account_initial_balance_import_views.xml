<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_initial_balance_import_form" model="ir.ui.view">
        <field name="name">account.initial.balance.import.form</field>
        <field name="model">account.initial.balance.import</field>
        <field name="arch" type="xml">
            <form string="Importar Saldos Iniciales">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Importar Saldos Iniciales</span>
                        </h1>
                    </div>

                    <group>
                        <group string="Configuración">
                            <field name="company_id" invisible="1"/>
                            <field name="journal_id"/>
                            <field name="date" widget="date"/>
                        </group>
                        <group string="Subir Archivo">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-info mb-0">
                        El archivo debe contener las columnas: Código de Cuenta, Débito, Crédito.
                        Descargue la plantilla para ver el formato completo.
                    </div>
                </sheet>
                <footer>
                    <button name="action_download_template"
                            string="Descargar Plantilla"
                            type="object"
                            class="btn-secondary"
                            icon="fa-download"/>
                    <button name="action_validate"
                            string="Importar"
                            type="object"
                            class="btn-primary"
                            icon="fa-upload"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_initial_balance_import" model="ir.actions.act_window">
        <field name="name">Importar Saldos Iniciales</field>
        <field name="res_model">account.initial.balance.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
