#. module: l10n_ve_assets
#: code:addons/l10n_ve_assets/models/res_font.py:0
#, python-format
msgid "Only TrueType (.ttf) and OpenType (.otf) files are supported."
msgstr "Solo se admiten archivos TrueType (.ttf) y OpenType (.otf)."

#. module: l10n_ve_assets
#: code:addons/l10n_ve_assets/models/res_font.py:0
#, python-format
msgid "Permission denied writing to %(path)s. Make sure the Odoo user can write to the fonts volume."
msgstr "Permiso denegado al escribir en %(path)s. Asegúrate de que el usuario de Odoo pueda escribir en el volumen de fuentes."

#. module: l10n_ve_assets
#: code:addons/l10n_ve_assets/models/res_font.py:0
#, python-format
msgid "Could not install font %(filename)s: %(error)s"
msgstr "No se pudo instalar la fuente %(filename)s: %(error)s"

#. module: l10n_ve_assets
#: code:addons/l10n_ve_assets/models/res_font.py:0
#, python-format
msgid "Could not create fonts directory %(path)s: %(error)s"
msgstr "No se pudo crear el directorio de fuentes %(path)s: %(error)s"

#. module: l10n_ve_assets
#: code:addons/l10n_ve_assets/models/res_font.py:0
#, python-format
msgid "Unsupported font extension '%(ext)s'. Only .ttf and .otf files are allowed."
msgstr "Extensión de fuente no soportada '%(ext)s'. Solo se permiten archivos .ttf y .otf."

#. module: l10n_ve_assets
#: model:ir.model.constraint,message:l10n_ve_assets.constraint_res_font_filename_unique
msgid "The file name must be unique."
msgstr "El nombre del archivo debe ser único."

#. module: l10n_ve_assets
#: model_terms:ir.actions.act_window,help:l10n_ve_assets.action_res_font
