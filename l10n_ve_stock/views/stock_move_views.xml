<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista tree de stock.move para movimientos de calculadora -->
    <record id="stock_move_calculator_tree_view" model="ir.ui.view">
        <field name="name">stock.move.calculator.tree</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-success">name and 'Entrada' in name</attribute>
                <attribute name="decoration-danger">name and 'Salida' in name</attribute>
                <attribute name="decoration-muted">name and 'Reversa' in name</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vista form de stock.move para calculadora -->
    <record id="stock_move_calculator_form_view" model="ir.ui.view">
        <field name="name">stock.move.calculator.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
