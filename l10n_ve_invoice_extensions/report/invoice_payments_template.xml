<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_payments">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Cierre Diario</h2>
                    <div class="mb-4">
                        <strong>Fecha: </strong>
                        <span t-out="report_date_formatted" />
                    </div>

                    <t t-foreach="invoices" t-as="invoice">
                        <div class="mb-4" style="page-break-inside: avoid; margin-top:20px !important;">
                            <div class="row mb-1" style="margin-top:20px !important;">
                                <div class="col-auto">
                                    <h4 t-out="invoice.name"></h4>
                                </div>
                                <div class="col-auto">
                                    <strong>Total: </strong>
                                    <span t-field="invoice.amount_total_in_currency_signed" />
                                </div>
                                <div class="col-auto">
                                    <strong>Cliente: </strong>
                                    <span t-field="invoice.partner_id.name" />
                                </div>
                                <div class="col-auto">
                                    <strong>CI/RIF: </strong>
                                    <span t-field="invoice.partner_id.l10n_ve_vat" />
                                </div>

                            </div>
                            <t t-if="invoice_payments_data[invoice.id]['show_details']">
                                <div>
                                    <strong>Detalles de Factura:</strong>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th style="width: 40%">Producto</th>
                                                <th class="text-end">Cant.</th>
                                                <th class="text-end">Precio Unitario</th>
                                                <th class="text-end">Precio Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="invoice_payments_data[invoice.id]['items']" t-as="item">
                                                <td>
                                                    <span t-out="item['product']"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="item['quantity']"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="item['price_unit']"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-out="item['subtotal']"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="mb-0">
                                            <tr>
                                                <td colspan="3"></td>
                                                <td class="text-end">
                                                    <span>Monto Total</span><br></br>
                                                    <span t-field="invoice.total_custom"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                            <table class="table" style="margin-bottom: 20px !important; ">
                                <thead>
                                    <tr>
                                        <th style="width: 15%">Fecha</th>
                                        <th>Método de pago</th>
                                        <th style="width: 20%">Referencia</th>
                                        <th style="width: 25%">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="payment_data" t-value="invoice_payments_data[invoice.id]" />
                                    <t t-set="payments" t-value="payment_data['payments']" />
                                    <tr t-foreach="payments" t-as="payment">
                                        <td class="text-center">
                                            <span t-out="payment['date']" />
                                        </td>
                                        <td class="text-center">
                                            <span t-out="payment['payment_method']" />
                                        </td>
                                        <td class="text-center">
                                            <span t-out="payment['reference']" />
                                        </td>
                                        <td class="text-center">
                                            <div t-if="payment['is_igtf']">
                                                <div t-out="payment['amount']"></div>
                                                <div>(<span t-out="payment['amount_original']"></span> x <span
                                                        t-out="payment['exchange_rate']"></span>)</div>
                                            </div>
                                            <span t-else="" t-out="payment['amount']" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>