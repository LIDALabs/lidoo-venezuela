<odoo>
  <data>
    <record model="ir.ui.view" id="view_account_move_form_l10n_ve_igtf_extension">
      <field name="name">view.account.move.form.l10n.ve.igtf.extension.form</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form" />
      <field name="arch" type="xml">
        <xpath expr="//page[@name='foreign_currency']//group" position="inside">
          <field name="amount_untaxed_in_usd" readonly="1" />
          <field name="amount_subject_to_igtf" readonly="posted_before" />
          <field name="bi_igtf" readonly="1" />
          <field name="bi_igtf_difference" readonly="1" />
        </xpath>
      </field>
    </record>
  </data>
</odoo>