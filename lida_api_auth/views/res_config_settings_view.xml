<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_api_auth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.api.auth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="lida_api_auth" string="Integration API" data-string="Integration API">
                    <block title="Integration API - LIDA">
                        <setting id="api_auth_pull_mode" string="Allow Integration API Pull" title="Allow Integration API Pull" help="Enable the partner instance to pull data from this instance.">
                            <field name="api_auth_enable_pull"/>
                            <div class="content-group" invisible="not api_auth_enable_pull">
                                <div class="row mt16">
                                    <label string="Pull API Key" for="api_auth_pull_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="api_auth_pull_api_key" />
                                    <button name="action_generate_pull_key" string="Generate" type="object" class="btn-link" icon="fa-refresh" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>

    </record>
</odoo>