<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_api_auth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.api.auth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="lida_api_auth" string="API de Integración" data-string="API de Integración">
                    <block title="API de Integración - LIDA">
                        <setting id="api_auth_pull_mode" string="Permitir consultas a la API (Pull)" title="Permitir consultas a la API (Pull)" help="Permite que el sistema externo consulte y cree datos en esta instancia.">
                            <field name="api_auth_enable_pull"/>
                            <div class="content-group" invisible="not api_auth_enable_pull">
                                <div class="row mt16">
                                    <label string="Clave API (Pull)" for="api_auth_pull_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="api_auth_pull_api_key" />
                                    <button name="action_generate_api_auth_pull_key" string="Generar" type="object" class="btn-link" icon="fa-refresh" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>

    </record>
</odoo>
