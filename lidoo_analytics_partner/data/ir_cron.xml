<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Alert Checker: runs every 4 hours -->
        <record id="ir_cron_check_alerts" model="ir.cron">
            <field name="name">LIDA Analytics: Check Alerts</field>
            <field name="model_id" ref="model_lidoo_analytics_alert" />
            <field name="state">code</field>
            <field name="code">model._cron_check_alerts()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <!-- Data Retention Cleanup: runs daily -->
        <record id="ir_cron_cleanup_reports" model="ir.cron">
            <field name="name">LIDA Analytics: Cleanup Old Reports</field>
            <field name="model_id" ref="model_lidoo_analytics_alert" />
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <!-- Pull Analytics: runs every hour -->
        <record id="ir_cron_pull_reports" model="ir.cron">
            <field name="name">LIDA Analytics: Pull Reports</field>
            <field name="model_id" ref="model_lidoo_analytics_client" />
            <field name="state">code</field>
            <field name="code">model._cron_pull_reports()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>