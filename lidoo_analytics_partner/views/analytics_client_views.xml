<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== TREE VIEW ==================== -->
    <record id="view_lidoo_analytics_client_tree" model="ir.ui.view">
        <field name="name">lidoo.analytics.client.tree</field>
        <field name="model">lidoo.analytics.client</field>
        <field name="arch" type="xml">
            <tree string="Clients" decoration-success="status == 'active'" decoration-warning="status == 'warning'" decoration-danger="status == 'inactive'">
                <field name="name" />
                <field name="database_uuid" />
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'warning'" decoration-danger="status == 'inactive'" />
                <field name="last_report_date" />
                <field name="report_count" string="Reports" />
                <field name="partner_id" />
            </tree>
        </field>
    </record>
    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_lidoo_analytics_client_form" model="ir.ui.view">
        <field name="name">lidoo.analytics.client.form</field>
        <field name="model">lidoo.analytics.client</field>
        <field name="arch" type="xml">
            <form string="Client">
                <header>
                    <button name="action_fetch_now" string="Fetch Now" type="object" class="btn-primary" invisible="sync_mode != 'pull'" />
                    <field name="status" widget="statusbar" statusbar_visible="active,warning,inactive" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_regenerate_api_key" string="Regenerate Key" type="object" class="oe_stat_button" icon="fa-refresh" confirm="Are you sure? The client will need the new key." invisible="sync_mode == 'pull'" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Client Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sync_mode" widget="radio" options="{'horizontal': true}" />
                            <field name="database_uuid" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="api_key" widget="CopyClipboardChar" invisible="sync_mode == 'pull'" />
                            <field name="endpoint_url" widget="CopyClipboardChar" invisible="sync_mode == 'pull'" />
                            <field name="base_target_url" invisible="sync_mode == 'push'" required="sync_mode == 'pull'" placeholder="https://client-instance.odoo.com/lidoo_client/analytics/status" options="{'suffix': '/api/lidoo/analytics/status'}" />
                            <field name="target_url" invisible="sync_mode == 'push'" readonly="1" />
                            <field name="pull_api_key" invisible="sync_mode == 'push'" required="sync_mode == 'pull'" password="True" />
                            <field name="last_report_date" />
                        </group>
                    </group>
                    <notebook>
                        <page name="reports" string="Reports">
                            <field name="report_ids" readonly="1">
                                <tree string="Reports" default_order="report_date desc">
                                    <field name="report_date" />
                                    <field name="odoo_version" />
                                    <field name="active_user_count" />
                                    <field name="database_size_display" string="DB Size" />
                                    <field name="uptime_display" string="Uptime" />
                                    <field name="cpu_usage" />
                                    <field name="memory_usage" />
                                </tree>
                            </field>
                        </page>
                        <page name="alerts" string="Alerts">
                            <field name="alert_ids">
                                <tree string="Alerts" editable="bottom">
                                    <field name="name" />
                                    <field name="alert_type" />
                                    <field name="threshold_value" />
                                    <field name="threshold_version" invisible="alert_type != 'version_below'" />
                                    <field name="active" />
                                    <field name="last_triggered" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="view_lidoo_analytics_client_kanban" model="ir.ui.view">
        <field name="name">lidoo.analytics.client.kanban</field>
        <field name="model">lidoo.analytics.client</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="status" />
                <field name="last_report_date" />
                <field name="database_uuid" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name" />
                                    </strong>
                                </div>
                                <field name="status" widget="label_selection" options="{'classes': {'active': 'success', 'warning': 'warning', 'inactive': 'danger'}}" />
                            </div>
                            <div class="o_kanban_record_body">
                                <span>
                                    UUID:
                                    <field name="database_uuid" />
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>
                                        Last report:
                                        <field name="last_report_date" widget="date" />
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_lidoo_analytics_client_search" model="ir.ui.view">
        <field name="name">lidoo.analytics.client.search</field>
        <field name="model">lidoo.analytics.client</field>
        <field name="arch" type="xml">
            <search string="Clients">
                <field name="name" />
                <field name="database_uuid" />
                <field name="partner_id" />
                <filter name="active_clients" string="Active" domain="[('status', '=', 'active')]" />
                <filter name="warning_clients" string="Warning" domain="[('status', '=', 'warning')]" />
                <filter name="inactive_clients" string="Inactive" domain="[('status', '=', 'inactive')]" />
                <group string="Group By" expand="0">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}" />
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>
    <!-- ==================== ACTION ==================== -->
    <record id="action_lidoo_analytics_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">lidoo.analytics.client</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_lidoo_analytics_client_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first client</p>
            <p>Create a client record and share the auto-generated API key
                with the customer to start receiving analytics.</p>
        </field>
    </record>
</odoo>