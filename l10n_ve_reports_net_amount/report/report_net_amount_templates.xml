<odoo>
    <data>
        <template id="net_amount_template">
            <div class="page">
                <div class="text-center" style="border-bottom: 2px solid black; margin-bottom: 20px;">
                    <h2>Reporte de Movimientos</h2>
                    <h3><t t-esc="o.product_id.name"/></h3>
                    <p>Del <t t-esc="o.date_from"/> al <t t-esc="o.date_to"/></p>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <h4>Ventas</h4>
                        <p><strong>Vendido:</strong> <t t-esc="o.qty_sold"/></p>
                        <p><strong>Devoluciones:</strong> <t t-esc="o.qty_sold_return"/></p>
                    </div>
                    <div class="col-6">
                        <h4>Compras</h4>
                        <p><strong>Comprado:</strong> <t t-esc="o.qty_purchased"/></p>
                        <p><strong>Devoluciones:</strong> <t t-esc="o.qty_purchased_return"/></p>
                    </div>
                </div>
                
                <div class="mt-4" style="background-color: #eee; padding: 15px;">
                    <strong>Balance Neto:</strong>
                    <span> <t t-esc="o.qty_sold - o.qty_sold_return"/> unidades netas vendidas.</span>
                </div>
            </div>
        </template>

        
        <template id="report_net_amount_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-call="l10n_ve_reports_net_amount.net_amount_template"/>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>