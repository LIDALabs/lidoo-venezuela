<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="report_sale_document_l10n_ve_sale" inherit_id="sale.report_saleorder_document">
    <xpath expr="//div[@class='page']" position="inside">
      <h3 t-if="doc.state == 'draft'"
        style="position:absolute;left:35px;top:250px;font-size:180px !important;opacity: 0.1;">
        COTIZACIÓN</h3>
    </xpath>
    <xpath expr="//div[@class='clearfix'][1]" position="after">
      <div class="row mt-4">
        <div class="col-12 text-center">
          <p class="fw-bold">NO FISCAL</p>
        </div>
      </div>
    </xpath>

    <xpath expr="//div[@class='page']" position="inside">
      <t t-set="address">
        <div t-field="doc.partner_id"
             t-options='{"widget": "contact", "fields":["address", "name"], "no_marker": True}'/>
        <p t-if="doc.partner_id.vat">
          <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
             t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
             <t t-else="">RIF</t>: <span
             t-field="doc.partner_id.l10n_ve_vat_formatted"/>
        </p>
      </t>
    </xpath>
  </template>
</odoo>
