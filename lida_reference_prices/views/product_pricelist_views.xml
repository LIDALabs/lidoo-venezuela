<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_pricelist_view" model="ir.ui.view">
            <field name="name">product.pricelist.form.inherit</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">
                <xpath expr="/form/sheet" position="before">
                    <header>
                        <field name="is_reference_price" readonly="1" invisible="1"/>

                        <button type="object" name="action_update_product_prices"
                            string="Actualizar precios"
                            invisible="not is_reference_price"
                            groups="base.group_no_one"
                            />

                        <button type="object" name="action_fill_reference_pricelist"
                            string="Llenar lista de precios referenciales"
                            invisible="not is_reference_price"
                            groups="base.group_no_one"
                            />
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>