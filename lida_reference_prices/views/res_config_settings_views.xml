<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lida_reference_price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pricing_setting_container" position="inside">
                <setting id="reference_pricelist_setting" string="Lista de Precios Referenciales">
                    <field name="reference_pricelist_id" class="o_light_label"
                        options="{'no_create_edit': True}" />
                </setting>
            </block>
        </field>
    </record>
</odoo>