<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bcv_rate_log_tree" model="ir.ui.view">
        <field name="name">bcv.rate.log.tree</field>
        <field name="model">bcv.rate.log</field>
        <field name="arch" type="xml">
            <tree string="BCV Rate Logs" decoration-success="status == 'success'" decoration-danger="status == 'error'" create="false">
                <field name="created_at" string="Fecha de registro"/>
                <field name="date" string="Fecha Valor"/>
                <field name="rate_usd" string="Tasa USD"/>
                <field name="automatico" string="Automático"/>
                <field name="status"/>
                <field name="error_type" optional="hide"/>
                <field name="error_message" optional="hide"/>
                <field name="company_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_bcv_rate_log_form" model="ir.ui.view">
        <field name="name">bcv.rate.log.form</field>
        <field name="model">bcv.rate.log</field>
        <field name="arch" type="xml">
            <form string="BCV Rate Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date" string="Fecha Valor"/>
                            <field name="rate_usd"/>
                            <field name="status"/>
                            <field name="automatico"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="created_at" string="Fecha de registro"/>
                        </group>
                    </group>
                    <group string="Detalles del error" invisible="status != 'error'">
                        <field name="error_type"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bcv_rate_log_search" model="ir.ui.view">
        <field name="name">bcv.rate.log.search</field>
        <field name="model">bcv.rate.log</field>
        <field name="arch" type="xml">
            <search string="Buscar logs">
                <field name="date"/>
                <field name="status"/>
                <filter string="Exitosas" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Con error" name="error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter string="Automático" name="automatic" domain="[('automatico', '=', True)]"/>
                <filter string="Manual" name="manual" domain="[('automatico', '=', False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Estado" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Automático" name="group_automatic" context="{'group_by': 'automatico'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bcv_rate_log" model="ir.actions.act_window">
        <field name="name">Historial de consultas BCV</field>
        <field name="res_model">bcv.rate.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bcv_rate_log_search"/>
    </record>
</odoo>
