<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_form_inherit_bcv" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.bcv</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(l10n_ve_currency_rate_live.action_bcv_rate_wizard)d" string="Tasa Referencial BCV" type="action" class="btn-primary" groups="account.group_account_invoice" invisible="name not in ['USD', 'VEF']"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
