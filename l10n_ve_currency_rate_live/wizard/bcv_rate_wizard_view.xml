<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bcv_rate_wizard_form" model="ir.ui.view">
        <field name="name">bcv_rate_wizard.form</field>
        <field name="model">bcv.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar Tasa BCV">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate_usd" widget="monetary" options="{'currency_field': 'company_id.currency_id'}"/>
                        <field name="date"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_get_bcv_rate" string="Consultar BCV" type="object" class="btn-secondary" data-hotkey="q"/>
                    <button name="action_update_prices" string="Actualizar Precios" type="object" class="btn-primary" data-hotkey="w" groups="account.group_account_readonly"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para Ventas -->
    <record id="action_bcv_rate_wizard" model="ir.actions.act_window">
        <field name="name">Consulta de Tasa BCV</field>
        <field name="res_model" eval="'bcv.rate.wizard'"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Acción específica para Contabilidad (para evitar conflictos de deduplicación) -->
    <record id="action_bcv_rate_wizard_account" model="ir.actions.act_window">
        <field name="name">Tasa BCV</field>
        <field name="res_model" eval="'bcv.rate.wizard'"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú en Contabilidad (Secuencia 34 para estar antes de Configuración que es 35) -->
    <menuitem id="menu_bcv_rate_wizard_account"
              name="Tasa BCV"
          parent="account.menu_finance_entries"
          action="action_bcv_rate_wizard"
          groups="account.group_account_readonly"
          sequence="34"/>

    <!-- Menú en Ventas -->
    <menuitem id="menu_bcv_rate_wizard_sale"
              name="Tasa BCV"
              parent="sale.sale_menu_root"
              action="action_bcv_rate_wizard"
              sequence="45"/>
</odoo>
