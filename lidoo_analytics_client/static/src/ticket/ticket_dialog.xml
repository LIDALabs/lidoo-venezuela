<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lidoo_analytics_client.TicketDialog">
        <t t-if="state.isLoading">
            <div class="modal-body text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x mb-3"/>
                <p class="text-muted">Loading...</p>
            </div>
        </t>
        <t t-else="">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fa fa-life-ring me-2"/>
                    Report an Issue
                </h4>
                <button type="button" class="btn-close" t-on-click="close"
                        aria-label="Close"/>
            </div>
            <div class="modal-body">
                <!-- Current view / route -->
                <div class="form-group mb-3">
                    <label class="o_form_label">Current View</label>
                    <div class="o_ticket_route o_form_field o_readonly">
                        <t t-esc="state.currentView"/>
                        <br/>
                        <span class="text-muted small">
                            Route: <t t-esc="state.currentRoute"/>
                        </span>
                    </div>
                </div>

                <!-- Screenshot placeholder -->
                <div class="form-group mb-3">
                    <label class="o_form_label">Screenshot</label>
                    <div class="alert alert-info py-2 mb-0 small">
                        <i class="fa fa-camera me-1"/>
                        Screenshot will be captured on submit.
                    </div>
                </div>

                <!-- User description -->
                <div class="form-group mb-3">
                    <label class="o_form_label" for="ticket_desc">What happened?</label>
                    <textarea id="ticket_desc"
                              class="form-control"
                              t-model="state.userText"
                              placeholder="Describe what you were doing, what you expected, and what went wrong..."
                              rows="4"/>
                </div>

                <!-- Logs placeholder -->
                <div class="form-group mb-3">
                    <label class="o_form_label">Server Logs</label>
                    <div class="alert alert-info py-2 mb-0 small">
                        <i class="fa fa-file-text-o me-1"/>
                        Last 100 log lines will be attached on submit.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" t-on-click="close"
                        t-att-disabled="state.submitting ? true : null">
                    Close
                </button>
            </div>
        </t>
    </templates>
</templates>
