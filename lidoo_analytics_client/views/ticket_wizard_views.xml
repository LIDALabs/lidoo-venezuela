<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lidoo_analytics_ticket_wizard_form" model="ir.ui.view">
        <field name="name">lidoo.analytics.ticket.wizard.form</field>
        <field name="model">lidoo.analytics.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportar incidencia">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Reportar incidencia</h2>
                        <p class="text-muted small">Adjuntá una captura y contanos qué pasó.</p>
                    </div>

                    <div class="mb-3">
                        <span class="o_form_label fw-bold">Descripción</span>
                        <field name="description"
                               widget="text"
                               nolabel="1"
                               placeholder="¿Qué estabas haciendo? ¿Qué esperabas que pasara? ¿Qué salió mal?"
                               class="w-100"
                               style="min-height: 120px;"/>
                    </div>

                    <div class="mb-3" invisible="not screenshot">
                        <span class="o_form_label fw-bold">Captura de pantalla</span>
                        <div class="border rounded p-2 bg-light">
                            <field name="screenshot" widget="image" nolabel="1" options="{'size': [400, 300]}"/>
                        </div>
                    </div>

                    <group string="Información técnica" col="2">
                        <field name="current_route" readonly="1"/>
                        <field name="screenshot_filename" readonly="1"/>
                    </group>

                    <div class="mt-3">
                        <span class="o_form_label fw-bold">Registros recientes del servidor</span>
                        <div style="max-height: 180px; overflow-y: auto; border: 1px solid #dee2e6; background-color: #f8f9fa; padding: 10px; border-radius: 4px; font-family: monospace; font-size: 0.85rem; white-space: pre-wrap;">
                            <field name="server_logs" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                </sheet>

                <footer>
                    <button string="Enviar" name="action_submit" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
