<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lidoo_analytics_ticket_wizard_form" model="ir.ui.view">
        <field name="name">lidoo.analytics.ticket.wizard.form</field>
        <field name="model">lidoo.analytics.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Report an Issue" class="o_form_nosheet">
                <div class="w-100 mb-3">
                    <field name="description"
                           widget="text"
                           nolabel="1"
                           placeholder="Describe what you were doing, what you expected, and what went wrong..."
                           class="w-100"
                           style="min-height: 100px;"/>
                </div>
                <field name="screenshot" invisible="1"/>
                <field name="screenshot_filename" invisible="1"/>

                <group string="Technical Info" groups="base.group_no_one" col="2">
                    <field name="current_route" readonly="1"/>
                    <field name="screenshot_filename" readonly="1"/>
                </group>

                <div groups="base.group_no_one" class="mt-3">
                    <label for="server_logs" string="Recent Server Logs" class="fw-bold text-muted small mb-1"/>
                    <div style="max-height: 150px; overflow-y: auto; border: 1px solid #ccc; background-color: #f8f9fa; padding: 8px; border-radius: 4px;">
                        <field name="server_logs" readonly="1" nolabel="1" class="text-monospace small"/>
                    </div>
                </div>

                <footer>
                    <button string="Send" name="action_submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
