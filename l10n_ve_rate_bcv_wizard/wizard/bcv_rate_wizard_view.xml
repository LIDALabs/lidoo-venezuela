<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bcv_rate_wizard_form" model="ir.ui.view">
        <field name="name">bcv.rate.wizard.form</field>
        <field name="model">bcv.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar Tasa BCV">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rate_usd" widget="monetary" options="{'currency_field': 'company_id.currency_id'}"/>
                        <field name="date"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_get_bcv_rate" string="Consultar BCV" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_update_prices" string="Actualizar Precios" type="object" class="btn-secondary" data-hotkey="w" invisible="not rate_usd"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bcv_rate_wizard" model="ir.actions.act_window">
        <field name="name">Consulta de Tasa BCV</field>
        <field name="res_model">bcv.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
