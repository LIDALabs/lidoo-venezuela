<odoo>
    <data>
        <record id="product_template_form_view_inherit_net_purchase" model="ir.ui.view">
            <field name="name">product.template.form.inherit.net.purchase</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <div name="button_box" position="inside">

                    <button class="oe_stat_button" 
                            name="action_view_net_purchases"
                            type="object" 
                            icon="fa-cube" 
                            help="Compras recibidas menos devoluciones">

                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value" style="display:flex; gap:0.5px;">
                                <field name="purchased_net_qty" widget="statinfo" nolabel="1" class="mr4"/>
                                <field name="uom_name"/>
                            </span>
                            <span class="o_stat_text">Compra Neta</span>
                        </div>
                    </button>

                </div>
            </field>
        </record>
        <record id="view_stock_move_net_purchase_tree" model="ir.ui.view">
            <field name="name">stock.move.net.purchase.tree</field>
            <field name="model">stock.move</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <tree string="Historial Neto" create="0" edit="0" delete="0" default_order="date desc" decoration-danger="qty_net_signed &lt; 0">
                    <field name="currency_id" column_invisible="True"/>
                    <field name="origin" string="Documento de origen"/>
                    <field name="date" string="Fecha"/>
                    <field name="picking_id" string="Referencia"/>
                    <field name="qty_net_signed" string="Cantidad (+/-)" sum="Total Neto"/>
                    <field name="product_price_unit" string="Precio Unitario" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>