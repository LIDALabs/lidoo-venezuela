<odoo>
    <data>
        <record id="view_flow_metrics_wizard_form" model="ir.ui.view">
            <field name="name">flow.metrics.wizard.form</field>
            <field name="model">flow.metrics.wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte de Producto por Periodo">
                    <group>
                        <field name="product_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <group>
                            <field name="date_from" />
                        </group>
                        <group>
                            <field name="date_to" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_sent_result" string="Calcular" type="object" class="btn-primary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_flow_metrics_wizard" model="ir.actions.act_window">
            <field name="name">Análisis de Movimientos</field>
            <field name="res_model">flow.metrics.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_flow_metrics_wizard" 
                name="Reporte de Movimientos" 
                parent="stock.menu_warehouse_report" 
                action="action_flow_metrics_wizard" 
                sequence="100"/>
    </data>
</odoo>