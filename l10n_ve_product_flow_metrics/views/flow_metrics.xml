<odoo>

    <data>
        <record id="view_flow_metrics_tree" model="ir.ui.view">
            <field name="name">flow.metrics.tree</field>
            <field name="model">flow.metrics</field>
            <field name="arch" type="xml">
                <tree string="Reporte de Movimientos" create="0" edit="0" delete="0" default_order="product_id">
                    <field name="product_id" string="Producto"/>
                    <field name="product_uom_id" string="Unidad"/>
                    <field name="date_from" string="Desde" invisible="1"/>
                    <field name="date_to" string="Hasta" invisible="1"/>
                    <field name="report_type" invisible="1"/>
                    <field name="product_selection" invisible="1"/>
                    <field name="qty_purchased" string="Comprado"/>
                    <field name="qty_purchased_return" string="Dev. Compra"/>
                    <field name="qty_purchased_net" string="Neto Compras" decoration-bf="1"/>
                    <field name="qty_sold" string="Vendido"/>
                    <field name="qty_sold_return" string="Dev. Venta"/>
                    <field name="qty_sold_net" string="Neto Ventas" decoration-bf="1"/>
                </tree>
            </field>
        </record>

        <record id="view_flow_metrics_form" model="ir.ui.view">
            <field name="name">flow.metrics.form</field>
            <field name="model">flow.metrics</field>
            <field name="arch" type="xml">
                <form string="Resultados del Análisis" create="0" edit="0" delete="0">
                    <field name="product_selection" invisible="1"/>
                    <field name="report_type" invisible="1"/>
                    <header>
                        <button string="Imprimir PDF" class="btn-primary" type="object" name="action_print_pdf"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info" role="alert" style="margin-bottom:10px;">
                            <div invisible="product_selection != 'all'">
                                Mostrando datos para <strong>Todos los productos registrados</strong>
                                en el periodo que va del <field name="date_from"/> al <field name="date_to"/>
                            </div>
                            <div invisible="product_selection != 'specific'">
                                Mostrando datos para <strong><field name="product_id" readonly="1" options="{'no_open': True}"/></strong>
                                en el periodo que va del <field name="date_from"/> al <field name="date_to"/>
                            </div>
                        </div>
                        <group>
                            <group string="Flujo de Compras" invisible="report_type == 'sales'">
                                <label for="qty_purchased"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_purchased" style="flex: none; width: 100%; margin-right: 1rem;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>
                                
                                <label for="qty_purchased_return"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_purchased_return" style="flex: none; width: 100%; margin-right: 1rem;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>

                                <label for="qty_purchased_net"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_purchased_net" style="flex: none; width: 100%; margin-right: 1rem; font-weight: bold; color: #008784;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>

                                <field name="standard_price_ves" string="Costo Unitario (VES)" readonly="1"/>
                                <field name="standard_price_usd" string="Costo Unitario (USD)" readonly="1"/>
                                <field name="total_purchased_ves" string="Total Compras (VES)" readonly="1"/>
                                <field name="total_purchased_usd" string="Total Compras (USD)" readonly="1"/>
                            </group>

                            <group string="Flujo de Ventas" invisible="report_type == 'purchases'">
                                <label for="qty_sold"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_sold" style="flex: none; margin-right: 1rem; width: 100%;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>
                                <label for="qty_sold_return"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_sold_return" style="flex: none; margin-right: 1rem; width: 100%;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>

                                <label for="qty_sold_net"/>
                                <div class="o_row" style="display: flex; justify-content: flex-start; gap: 2.5rem;">
                                    <field name="qty_sold_net" style="flex: none; margin-right: 1rem; width: 100%; font-weight: bold; color: #008784;"/>
                                    <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                                </div>

                                <field name="sale_price_ves" string="Costo Unitario (VES)" readonly="1"/>
                                <field name="sale_price_usd" string="Costo Unitario (USD)" readonly="1"/>
                                <field name="total_sold_ves" string="Total Ventas (VES)" readonly="1"/>
                                <field name="total_sold_usd" string="Total Ventas (USD)" readonly="1"/>
                            </group>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>
    </data>

</odoo>